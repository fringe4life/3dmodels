{
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  },
  "language_servers": ["...", "!eslint", "!tailwindcss-language-server"],
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "HTML": {
      "language_servers": ["...", "!tailwindcss-language-server"]
    },
    "CSS": {
      "language_servers": ["...", "!tailwindcss-language-server"]
    }
  }
}
