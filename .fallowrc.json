{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "boundaries": {
    "preset": "bulletproof"
  },
  "rules": {
    "unused-dependencies": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "unused-dependency-overrides": "off",
    "private-type-leaks": "off"
  },
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "framework": [
    {
      "name": "next-unstable-segment-config",
      "enablers": ["next"],
      "usedExports": [
        {
          "pattern": "src/app/**/{page,layout}.{ts,tsx}",
          "exports": ["unstable_ensureStatic"]
        }
      ]
    }
  ],
  "ignorePatterns": ["doctor.config.ts"],
  "ignoreDependencies": [
    "next-devtools-mcp",
    "@pandacss/mcp",
    "@styled-system/css",
    "@styled-system/patterns",
    "@styled-system/recipes"
  ],
  "duplicates": {
    "enabled": true,
    "minOccurrences": 3,
    "minLines": 15
  },
  "health": {
    "maxCyclomatic": 12,
    "maxCognitive": 12,
    "maxCrap": 30,
    "thresholdOverrides": [{ "files": ["src/db/**"], "maxCrap": 80 }]
  }
}
