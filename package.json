    "@biomejs/biome": "2.5.3",
    "@happy-dom/global-registrator": "20.11.1",
    "@pandacss/dev": "2.0.0-beta.11",
    "@pandacss/preset-base": "2.0.0-beta.11",
    "@pandacss/preset-panda": "2.0.0-beta.11",
    "@pandacss/preset-typography": "2.0.0-beta.11",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@varlock/nextjs-integration": "1.1.6",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "next-devtools-mcp": "0.4.0",
    "react-doctor": "0.9.1",
    "typescript": "7.0.2",
    "typescript-plugin-directives": "0.0.3",
    "ultracite": "7.9.4"
  },
  "name": "3d-models",
  "scripts": {
    "dev": "next dev",
    "dev:inspect": "bun --bun run next dev --inspect",
    "next:upgrade": "bun --bun run next upgrade",
    "next:analyze": "bun --bun run next experimental-analyze",
    "build": "bun varlock run -- next build",
    "build:debug": "bun --bun run next build --debug-prerender",
    "start": "bun run next start",
    "test": "NODE_ENV=test bun test",
    "test:watch": "NODE_ENV=test bun test --watch",
    "test:unit": "NODE_ENV=test bun test tests/unit",
    "test:components": "NODE_ENV=test bun test tests/components",
    "test:integration": "NODE_ENV=test bun test tests/integration",
    "test:e2e": "NODE_ENV=test playwright test",
    "e2e:open": "NODE_ENV=test playwright test --ui",
    "e2e:codegen": "NODE_ENV=test playwright codegen http://localhost:3000",
    "typegen": "bun run next typegen",
    "env:typegen": "varlock typegen",
    "auth:generate": "varlock run -- bun x auth@1.7.0-rc.2 generate --config ./src/lib/auth.cli.config.ts --output ./src/db/schema/auth.ts --yes",
    "db:generate": "varlock run -- bun x drizzle-kit generate",
    "db:migrate": "varlock run -- bun x drizzle-kit migrate",
    "db:push": "varlock run -- bun x drizzle-kit push --force",
    "db:studio": "varlock run -- bun x drizzle-kit studio",
    "db:seed": "varlock run -- bun --conditions=react-server src/db/seed.ts",
    "db:drop": "varlock run -- bun --conditions=react-server src/db/drop-tables.ts",
    "prepare": "panda build && husky",
    "type": "bun run typegen && tsc --noEmit --skipLibCheck --project tsconfig.json",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "doctor": "ultracite doctor",
    "ultracite:upgrade": "bun x ultracite@latest init --pm bun --agents cursor-cli --linter biome --hooks cursor --frameworks next --quiet",
    "react-doctor": "react-doctor . -y --no-score",
    "react-doctor:staged": "react-doctor . --staged -y --no-score --blocking error"
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "trustedDependencies": [],
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@next/env": "npm:@varlock/nextjs-integration",
    "@opentelemetry/core": "2.10.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "hono": "4.12.32",
    "postcss": "8.5.20",
    "qs": "6.15.3",
    "zod": "^4.3.6"
  }
}
