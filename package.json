{
  "name": "3d-models",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "varlock run -- bun x auth@1.7.4 generate --config ./src/lib/auth.cli.config.ts --output ./src/db/schema/auth.ts --yes",
    "build": "bun varlock run -- next build",
    "build:debug": "bun --bun run next build --debug-prerender",
    "check": "ultracite check",
    "db:drop": "varlock run -- bun --conditions=react-server src/db/drop-tables.ts",
    "db:generate": "varlock run -- bun x drizzle-kit generate",
    "db:migrate": "varlock run -- bun x drizzle-kit migrate",
    "db:push": "varlock run -- bun x drizzle-kit push --force",
    "db:seed": "varlock run -- bun --conditions=react-server src/db/seed.ts",
    "db:studio": "varlock run -- bun x drizzle-kit studio",
    "dev": "varlock run -- bun run next dev",
    "dev:inspect": "bun --bun run next dev --inspect",
    "doctor": "ultracite doctor",
    "e2e:codegen": "NODE_ENV=test playwright codegen http://localhost:3000",
    "e2e:open": "NODE_ENV=test playwright test --ui",
    "env:typegen": "varlock typegen",
    "fix": "ultracite fix",
    "next:analyze": "bun varlock run -- next analyze",
    "next:upgrade": "bun --bun run next upgrade",
    "prepare": "panda build && husky",
    "react-doctor": "react-doctor . -y --no-score",
    "react-doctor:staged": "react-doctor . --staged -y --no-score --blocking error",
    "start": "bun run next start",
    "test": "VARLOCK_ENV=test NODE_ENV=test bun test",
    "test:affected": "VARLOCK_ENV=test NODE_ENV=test bun test --changed --pass-with-no-tests",
    "test:components": "VARLOCK_ENV=test NODE_ENV=test bun test tests/components",
    "test:e2e": "VARLOCK_ENV=test NODE_ENV=test playwright test",
    "test:integration": "VARLOCK_ENV=test NODE_ENV=test bun test tests/integration",
    "test:unit": "VARLOCK_ENV=test NODE_ENV=test bun test tests/unit",
    "test:watch": "VARLOCK_ENV=test NODE_ENV=test bun test --watch",
    "type": "bun run typegen && tsc --noEmit --skipLibCheck --project tsconfig.json",
    "typegen": "bun run next typegen",
    "ultracite:upgrade": "ultracite upgrade --pm bun"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@next/env": "npm:@varlock/nextjs-integration",
    "hono": "4.13.7"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@libsql/client": "0.18.0",
    "@oddbird/css-anchor-positioning": "0.10.2",
    "@oddbird/popover-polyfill": "0.7.2",
    "@rsc-boundary/next": "0.3.2",
    "@varlock/bitwarden-plugin": "2.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "elysia": "1.4.30",
    "file-type": "22.0.1",
    "next": "16.4.0-canary.44",
    "next-safe-action": "8.7.3",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "slugify": "1.6.9",
    "uuidv7": "1.2.1",
    "valibot": "1.5.0",
    "varlock": "1.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "20.14.5",
    "@pandacss/dev": "2.0.0-beta.18",
    "@pandacss/mcp": "2.0.0-beta.18",
    "@pandacss/preset-base": "2.0.0-beta.18",
    "@pandacss/preset-panda": "2.0.0-beta.18",
    "@pandacss/preset-typography": "2.0.0-beta.18",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@varlock/nextjs-integration": "1.2.2",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.27.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "next-devtools-mcp": "0.4.0",
    "react-doctor": "0.9.14",
    "typescript": "7.0.2",
    "typescript-plugin-directives": "0.0.3",
    "ultracite": "^7.12.0"
  },
  "trustedDependencies": []
}
